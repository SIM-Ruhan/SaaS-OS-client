{
  "expo": {
    "name": "ShopOS",
    "slug": "shopos-commerce",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "shopos",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "ios": { "supportsTablet": true, "bundleIdentifier": "com.shopos.commerce" },
    "android": { "package": "com.shopos.commerce", "adaptiveIcon": { "foregroundImage": "./assets/icon.png", "backgroundColor": "#17382e" } },
    "plugins": ["expo-secure-store"]
  }
}
